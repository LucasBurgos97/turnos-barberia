# En Vercel: Settings → Environment Variables.

# URL de la API en Render. En local no hace falta (Vite redirige /api a localhost:3000).
VITE_API_URL=https://TU-API.onrender.com

# Login del dueño con Supabase Auth (Project Settings → API). La anon key es pública, puede ir en el frontend.
# Si se dejan vacías, el panel usa el login de desarrollo de `npm run dev:api:mem`.
VITE_SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=
