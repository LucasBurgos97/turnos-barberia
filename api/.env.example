# Copiar a api/.env (en Render: Environment → Environment Variables)

# Supabase → Project Settings → Database → Connection string → "Transaction pooler" (puerto 6543).
# Usar el pooler: Render no tiene IPv6 y la conexión directa de Supabase sí lo pide.
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_PASSWORD@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

PORT=3000

# Dominios del frontend separados por coma (Vercel y local)
CORS_ORIGINS=http://localhost:5173

# Para validar el login del dueño (Supabase → Project Settings → API → Project URL)
SUPABASE_URL=https://TU_PROJECT_REF.supabase.co
# Solo si el proyecto usa el "Legacy JWT secret" (HS256). Si usa JWT Signing Keys, dejalo vacío.
SUPABASE_JWT_SECRET=

# URL pública del frontend (Vercel): se usa para los links de los WhatsApp
PUBLIC_WEB_URL=http://localhost:5173

# WhatsApp Cloud API (ver docs/whatsapp.md). WHATSAPP_MODE=console imprime los mensajes en vez de mandarlos.
WHATSAPP_MODE=cloud
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Secreto que manda el cron a /internal/reminders/run
CRON_SECRET=

# Característica que se asume si el cliente no la escribe (Salta capital)
DEFAULT_AREA_CODE=387
